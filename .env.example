# Copy this file to .env.local and fill in your own values. .env.local is never committed.

# Supabase project: Project Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Google Cloud: the "Web application" OAuth client ID (Supabase checks Google's ID token against it)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=1234567890-abc.apps.googleusercontent.com
